{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LandingZoneProvisioning",
      "Effect": "Allow",
      "Action": [
        "access-analyzer:*",
        "backup:*",
        "cloudtrail:*",
        "config:*",
        "directconnect:*",
        "ec2:*",
        "guardduty:*",
        "iam:*",
        "inspector2:*",
        "kms:*",
        "logs:*",
        "macie2:*",
        "organizations:*",
        "ram:*",
        "route53:*",
        "route53resolver:*",
        "s3:*",
        "securityhub:*",
        "ssm:*"
      ],
      "Resource": "*"
    }
  ]
}
